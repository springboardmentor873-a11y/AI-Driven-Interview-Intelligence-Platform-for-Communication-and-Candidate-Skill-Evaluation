# SmartHire AI - Environment Configuration (Template)

PROJECT_NAME=SmartHire AI Backend
API_V1_STR=/api/v1

# Security & JWT Configuration
SECRET_KEY=smarthire_ai_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
# You can provide individual credentials:
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=smarthire_ai

# OR provide a single combined DATABASE_URL (takes priority if uncommented):
# Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password@localhost:5432/smarthire_ai
# Cloud PostgreSQL (Neon / Supabase):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-sample-pool.us-east-2.aws.neon.tech/smarthire_ai?sslmode=require
# Zero-setup local SQLite fallback:
# DATABASE_URL=sqlite:///./smarthire.db

# CORS Configuration (Allowed frontend URLs separated by commas)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# File Upload Settings
UPLOAD_DIR=uploads/resumes
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=.pdf,.docx
