# Dev default (no Postgres needed):
DATABASE_URL=sqlite:///./smarthire.db
# Postgres (docker compose up -d):
# DATABASE_URL=postgresql+psycopg2://smarthire:smarthire@localhost:5432/smarthire
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@smarthire.ai
ADMIN_PASSWORD=Admin@12345

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_RESUMES_PER_USER=5
FRONTEND_URL=http://localhost:5173

# Google OAuth2 (optional - leave empty to hide the Google button)
# Create credentials at console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
