# Copy to .env and replace every "change-me" (see README/instructions).
# Use a URL-safe password (letters and digits), because it is embedded in the URLs below.

ENVIRONMENT=development

# PostgreSQL container (used by docker-compose.yml)
POSTGRES_USER=smarthire
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smarthire
POSTGRES_PORT=5433

# Used when running the app, Alembic or pytest on your machine (host -> published DB port)
DATABASE_URL=postgresql+asyncpg://smarthire:change-me@localhost:5433/smarthire
# Tests only. The database name MUST end with "_test".
TEST_DATABASE_URL=postgresql+asyncpg://smarthire:change-me@localhost:5433/smarthire_test

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Comma-separated list of allowed browser origins (React dev server)
CORS_ORIGINS=http://localhost:5173
# Used to build password-reset links (never taken from request headers)
FRONTEND_URL=http://localhost:5173

# --- Authentication ---
# Random signing secret, at least 32 characters. The app refuses to start with the placeholder.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_JWT_SECRET
# Refresh-token cookie. Local HTTP development needs COOKIE_SECURE=false; production must be true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Google OAuth (Google Cloud Console OAuth 2.0 Web Client ID) ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=