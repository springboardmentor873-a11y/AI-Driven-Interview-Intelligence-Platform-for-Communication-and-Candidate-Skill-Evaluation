# Copy to .env (local) or paste into your host's environment settings (production).
# Required in production: ENVIRONMENT, JWT_SECRET, DATABASE_URL, ADMIN_EMAIL, ADMIN_PASSWORD, APP_URL.

ENVIRONMENT=development                 # set to production when live; the app refuses unsafe settings then
APP_URL=http://localhost:5173           # public URL of the app, used in emails and reset links
CORS_ORIGINS=http://localhost:5173

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-secret-in-production

# Database. Local: SQLite. Production: free Neon Postgres (paste the connection string as-is).
DATABASE_URL=sqlite:///./smarthire.db

# First admin account (created on first start if no admin exists)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_NAME=Platform Admin
SEED_DEMO=true                          # demo users; must be false in production
ALLOW_RECRUITER_SIGNUP=false            # recruiters are created by an admin

# Email. Free option: Brevo SMTP (300 emails/day). Without SMTP_HOST emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartHire AI <no-reply@yourcompany.com>

# Google sign-in (free). OAuth client ID of type "Web application".
GOOGLE_CLIENT_ID=

# Company details shown in the privacy notice and emails
COMPANY_NAME=SmartHire AI
SUPPORT_EMAIL=support@yourcompany.com
GRIEVANCE_OFFICER=Name, Grievance Officer, grievance@yourcompany.com

# Data retention in days
RETENTION_AUDIO_DAYS=30
RETENTION_RECORDING_DAYS=90

# Error tracking (free Sentry developer plan)
SENTRY_DSN=
